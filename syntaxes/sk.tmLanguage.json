{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Skorpion",
  "scopeName": "source.skorpion",
  "patterns": [
    { "include": "#comments" },
    { "include": "#include-c" },
    { "include": "#use-directive" },
    { "include": "#keywords" },
    { "include": "#type-declarations" },
    { "include": "#builtin-types" },
    { "include": "#constants" },
    { "include": "#builtin-functions" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#strings" },
    { "include": "#functions" },
    { "include": "#types" },
    { "include": "#variables" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash",
          "match": "//.*$"
        },
        {
          "name": "comment.block",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },

    "include-c": {
      "patterns": [
        {
          "name": "meta.embedded.block.c",
          "begin": "(includeC)\\s*(~~~)",
          "beginCaptures": {
            "1": { "name": "keyword.control" },
            "2": { "name": "punctuation.section.embedded.begin" }
          },
          "end": "(~~~)",
          "endCaptures": {
            "1": { "name": "punctuation.section.embedded.end" }
          },
          "contentName": "source.c",
          "patterns": [
            { "include": "source.c" }
          ]
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control",
          "match": "\\b(if|elsif|else|while|for|case|try|catch|throw|return|break|continue|new|as|in|use)\\b"
        },
        {
          "name": "storage.modifier",
          "match": "\\b(const|void|includeC)\\b"
        },
        {
          "name": "constant.language",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },

    "type-declarations": {
      "patterns": [
        {
          "match": "\\b(const)\\s+([A-Z]\\w*)",
          "captures": {
            "1": { "name": "storage.modifier" },
            "2": { "name": "entity.name.type" }
          }
        }
      ]
    },

    "builtin-types": {
      "patterns": [
        {
          "name": "storage.type.primitive",
          "match": "\\b(int|float|double|string|bool|any|void|arr|Error)\\b"
        },
        {
          "match": "\\barr\\s*\\[\\s*(\\w+)\\s*\\]",
          "captures": {
            "0": { "name": "storage.type.array" },
            "1": { "name": "storage.type.primitive" }
          }
        }
      ]
    },

    "constants": {
      "patterns": [
        {
          "name": "constant.language",
          "match": "\\bnull\\b"
        },
        {
          "name": "constant.other.placeholder",
          "match": "\\b_\\b"
        }
      ]
    },

    "builtin-functions": {
      "patterns": [
        {
          "name": "support.function.builtin",
          "match": "\\b(to_int|to_float|to_double|to_bool|to_string|type|length|detruncate)\\b(?=\\s*\\()"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator",
          "match": "&&|\\|\\||==|!=|<=|>=|\\.\\.|->|[+\\*/%<>=!?:$^]|#|&"
        },
        {
          "name": "keyword.operator",
          "match": "-\\s"
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.float",
          "match": "-?\\d+\\.\\d+f?"
        },
        {
          "name": "constant.numeric.integer",
          "match": "-?\\d+\\b"
        },
        {
          "name": "constant.numeric.precision",
          "match": "(?<=\\^)(X\\{\\d+,\\d+\\}|X\\d+|\\d+f?)"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape",
              "match": "\\\\."
            }
          ]
        }
      ]
    },

    "functions": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_]\\w*)\\s*(\\*)?\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function" },
            "2": { "name": "storage.modifier.non-exportable" }
          }
        }
      ]
    },

    "types": {
      "patterns": [
        {
          "name": "entity.name.type",
          "match": "\\b[A-Z]\\w*\\b"
        }
      ]
    },

    "variables": {
      "patterns": [
        {
          "name": "variable.other.readwrite",
          "match": "\\b[a-z_]\\w*\\b"
        }
      ]
    },

    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.parens",
          "match": "[()]"
        },
        {
          "name": "punctuation.section.brackets",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.braces",
          "match": "[{}]"
        },
        {
          "name": "punctuation.separator",
          "match": "[,;.]"
        }
      ]
    }
  }
}