{
  "name": "sk-vsce",
  "displayName": "Skorpion Language Extension",
  "icon": "./images/icon.png",
  "publisher": "iamtowvee",
  "version": "2026.10.1",
  "license": "Apache-2.0",
  "main": "./extension.js",
  "activationEvents": [],
  "repository": {
    "url": "https://github.com/skorpion-language/sk-vsce"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "skorpion",
        "aliases": ["Skorpion", "skorpion", "sk", "Sk", "sK", "SK"],
        "extensions": [".sk"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/skorpion.svg",
          "dark": "./icons/skorpion.svg"
        }
      },
      {
        "id": "spc",
        "aliases": ["Skorpion Project Configuration", "SPC", "spc"],
        "extensions": [".spc"],
        "configuration": "./spc-language-configuration.json",
        "icon": {
          "light": "./icons/spc.svg",
          "dark": "./icons/spc.svg"
        }
      }
    ],
    "snippets": [
      {
        "language": "skorpion",
        "path": "./snippets/skorpion.json"
      },
      {
        "language": "spc",
        "path": "./snippets/spc.json"
      }
    ],
    "grammars": [
      {
        "language": "skorpion",
        "scopeName": "source.skorpion",
        "path": "./syntaxes/sk.tmLanguage.json"
      },
      {
        "language": "spc",
        "scopeName": "source.spc",
        "path": "./syntaxes/spc.tmLanguage.json"
      },
      {
        "scopeName": "markdown.skorpion.codeblock",
        "path": "./syntaxes/skorpion-markdown-injection.json",
        "injectTo": ["text.html.markdown"],
        "embeddedLanguages": {
          "meta.embedded.block.skorpion": "skorpion"
        }
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "spc",
        "scopes": {
          "string":   ["string.quoted.double.spc"],
          "number":   ["constant.numeric.float.spc"],
          "comment":  ["comment.line.number-sign.spc"],
          "variable": ["entity.name.tag.spc"],
          "operator": ["punctuation.separator.array.spc"]
        }
      }
    ],
    "configurationDefaults": {
      "[spc]": {
        "editor.bracketPairColorization.enabled": true,
        "editor.semanticHighlighting.enabled": true
      }
    },

    "viewsContainers": {
      "activitybar": [
        {
          "id": "skorpion-tools",
          "title": "Skorpion Tools",
          "icon": "./icons/skorpion.svg"
        }
      ]
    },
    "views": {
      "skorpion-tools": [
        {
          "id": "skorpion-main-view",
          "icon": "./icons/sk-vsce-baricon.svg",
          "name": "Project Actions",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "skorpion-main-view",
        "contents": "Click 'Init project' to start.",
        "when": "!skorpion.projectInitialized"
      }
    ],
    "commands": [
      {
        "command": "skorpion.initProject",
        "title": "Init project",
        "icon": "$(new-folder)"
      },
      {
        "command": "skorpion.createTemplate",
        "title": "Create template",
        "icon": "$(file-add)"
      },
      {
        "command": "skorpion.updateGitignore",
        "title": "Add (update) .gitignore",
        "icon": "$(git-ignore)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "skorpion.initProject",
          "when": "view == skorpion-main-view",
          "group": "navigation"
        },
        {
          "command": "skorpion.createTemplate",
          "when": "view == skorpion-main-view && skorpion.projectInitialized",
          "group": "navigation"
        },
        {
          "command": "skorpion.updateGitignore",
          "when": "view == skorpion-main-view && skorpion.projectInitialized",
          "group": "navigation"
        }
      ]
    }
  }
}